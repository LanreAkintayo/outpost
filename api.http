@baseUrl = http://localhost:8080

### Health Check
GET {{baseUrl}}/health
Accept: application/json

### Create Application
# @name createApplication
POST {{baseUrl}}/api/v1/applications
Content-Type: application/json

{
  "name": "PayNova"
}

### Get Application by ID
@appId = {{createApplication.response.body.id}}
GET {{baseUrl}}/api/v1/applications/{{appId}}
Accept: application/json

### Verify API Key
@apiKey = {{createApplication.response.body.api_key}}
GET {{baseUrl}}/api/v1/auth/verify
Authorization: Bearer {{apiKey}}
Accept: application/json

### Create Endpoint
# @name createEndpoint
POST {{baseUrl}}/api/v1/endpoints
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "url": "https://apiv2.zara.com/webhooks",
  "description": "Zara Fulfillment Webhook",
  "recipient_id": "zara"
}


### List Endpoints
GET {{baseUrl}}/api/v1/endpoints
Authorization: Bearer {{apiKey}}
Accept: application/json

### Get Endpoint by ID
@endpointId = {{createEndpoint.response.body.id}}
GET {{baseUrl}}/api/v1/endpoints/{{endpointId}}
Authorization: Bearer {{apiKey}}
Accept: application/json

### Update Endpoint
PUT {{baseUrl}}/api/v1/endpoints/{{endpointId}}
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "description": "Zara Fulfillment (Paused)",
  "status": "inactive"
}

### Delete Endpoint
DELETE {{baseUrl}}/api/v1/endpoints/{{endpointId}}
Authorization: Bearer {{apiKey}}

### Create Event Type (payment.succeeded)
# @name createEventType
POST {{baseUrl}}/api/v1/event-types
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "name": "payment.succeeded",
  "description": "Triggered when a charge is successfully captured"
}

### Create Event Type (payment.failed)
POST {{baseUrl}}/api/v1/event-types
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "name": "payment.failed",
  "description": "Triggered when a customer card payment fails"
}

### Create Event Type (Negative Test: Invalid dot-notation)
POST {{baseUrl}}/api/v1/event-types
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "name": "paymentsucceeded",
  "description": "Should fail because dot-notation is required"
}

### List Event Types
GET {{baseUrl}}/api/v1/event-types
Authorization: Bearer {{apiKey}}
Accept: application/json

### Get Event Type by ID
@eventTypeId = {{createEventType.response.body.id}}
GET {{baseUrl}}/api/v1/event-types/{{eventTypeId}}
Authorization: Bearer {{apiKey}}
Accept: application/json

### Delete Event Type
DELETE {{baseUrl}}/api/v1/event-types/{{eventTypeId}}
Authorization: Bearer {{apiKey}}

### Subscribe Endpoint to Event Type
# @name subscribeEndpoint
POST {{baseUrl}}/api/v1/endpoints/{{endpointId}}/subscriptions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "event_type_id": "{{eventTypeId}}"
}

### Duplicate Subscription (Negative Test: Conflict 409)
POST {{baseUrl}}/api/v1/endpoints/{{endpointId}}/subscriptions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "event_type_id": "{{eventTypeId}}"
}

### List Subscriptions for Endpoint
GET {{baseUrl}}/api/v1/endpoints/{{endpointId}}/subscriptions
Authorization: Bearer {{apiKey}}
Accept: application/json

### Unsubscribe Endpoint from Event Type
DELETE {{baseUrl}}/api/v1/endpoints/{{endpointId}}/subscriptions/{{eventTypeId}}
Authorization: Bearer {{apiKey}}
