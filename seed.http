@customerCreatedId = d4756667-2189-4a38-b8ad-67e8b19715ce


###############################################################################
# STEP 3: CREATE ENDPOINTS
###############################################################################

### 3.1 Endpoint 1: Internal Ledger Service (Global Broadcast)
# @name epLedger
POST {{baseUrl}}/api/v1/endpoints
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "url": "https://webhook.site/paynova-ledger",
  "description": "Internal Financial Ledger & Accounting",
  "recipient_id": ""
}

### 3.2 Endpoint 2: Fraud & Risk Shield (Global Broadcast)
# @name epFraud
POST {{baseUrl}}/api/v1/endpoints
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "url": "https://webhook.site/paynova-fraud",
  "description": "Real-time Fraud & Anomaly Detection",
  "recipient_id": ""
}

### 3.3 Endpoint 3: Merchant - Acme Commerce (Recipient-Specific)
# @name epAcme
POST {{baseUrl}}/api/v1/endpoints
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "url": "https://webhook.site/acme-storefront",
  "description": "Acme Commerce Order Fulfillment Webhook",
  "recipient_id": "merchant_acme_01"
}

### 3.4 Endpoint 4: Merchant - Nexus Electronics (Recipient-Specific)
# @name epNexus
POST {{baseUrl}}/api/v1/endpoints
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "url": "https://webhook.site/nexus-storefront",
  "description": "Nexus Electronics Notification Webhook",
  "recipient_id": "merchant_nexus_99"
}

