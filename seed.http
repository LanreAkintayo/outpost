@nexusEpId = 97bc3d9c-e233-44fc-8e4f-f49f29c1a160


###############################################################################
# STEP 4: CREATE SUBSCRIPTIONS
###############################################################################

### 4.1 Subscribe Ledger to payment.succeeded
POST {{baseUrl}}/api/v1/endpoints/{{ledgerEpId}}/subscriptions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "event_type_id": "{{paymentSucceededId}}"
}

### 4.2 Subscribe Ledger to refund.created
POST {{baseUrl}}/api/v1/endpoints/{{ledgerEpId}}/subscriptions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "event_type_id": "{{refundCreatedId}}"
}

### 4.3 Subscribe Fraud Shield to payment.failed
POST {{baseUrl}}/api/v1/endpoints/{{fraudEpId}}/subscriptions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "event_type_id": "{{paymentFailedId}}"
}

### 4.4 Subscribe Fraud Shield to payment.succeeded
POST {{baseUrl}}/api/v1/endpoints/{{fraudEpId}}/subscriptions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "event_type_id": "{{paymentSucceededId}}"
}

### 4.5 Subscribe Acme Commerce to payment.succeeded
POST {{baseUrl}}/api/v1/endpoints/{{acmeEpId}}/subscriptions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "event_type_id": "{{paymentSucceededId}}"
}

### 4.6 Subscribe Acme Commerce to payment.failed
POST {{baseUrl}}/api/v1/endpoints/{{acmeEpId}}/subscriptions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "event_type_id": "{{paymentFailedId}}"
}

### 4.7 Subscribe Nexus Electronics to payment.succeeded
POST {{baseUrl}}/api/v1/endpoints/{{nexusEpId}}/subscriptions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "event_type_id": "{{paymentSucceededId}}"
}


###############################################################################
# STEP 5: VERIFICATION (READ BACK)
###############################################################################

### 5.1 List all registered endpoints
GET {{baseUrl}}/api/v1/endpoints
Authorization: Bearer {{apiKey}}
Accept: application/json

### 5.2 List all event types
GET {{baseUrl}}/api/v1/event-types
Authorization: Bearer {{apiKey}}
Accept: application/json

### 5.3 List subscriptions for Acme Commerce
GET {{baseUrl}}/api/v1/endpoints/{{acmeEpId}}/subscriptions
Authorization: Bearer {{apiKey}}
Accept: application/json


###############################################################################
# STEP 6: EVENT INGESTION (MILESTONE 2.1)
###############################################################################

### 6.1 Ingest payment.succeeded for Acme Commerce
# Should fan out to: PayNova Ledger, Fraud Shield, and Acme Commerce (3 queued)
# @name ingestAcmePayment
POST {{baseUrl}}/api/v1/events
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "event_type": "payment.succeeded",
  "recipient_id": "merchant_acme_01",
  "payload": {
    "order_id": "ord_acme_8801",
    "customer": {
      "id": "cust_992",
      "name": "Sarah Connor",
      "email": "sarah@cyberdyne.com"
    },
    "amount": 25000,
    "currency": "USD"
  },
  "idempotency_key": "tx_acme_sale_8801"
}

### 6.2 Ingest payment.failed for Acme Commerce
# Should fan out to: Fraud Shield and Acme Commerce (2 queued)
POST {{baseUrl}}/api/v1/events
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "event_type": "payment.failed",
  "recipient_id": "merchant_acme_01",
  "payload": {
    "order_id": "ord_acme_8802",
    "error_code": "insufficient_funds",
    "amount": 10000,
    "currency": "USD"
  },
  "idempotency_key": "tx_acme_failed_8802"
}

### 6.3 Idempotency Key Duplicate Test
# Retrying with the same idempotency key returns existing event (0 queued deliveries)
POST {{baseUrl}}/api/v1/events
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "event_type": "payment.succeeded",
  "recipient_id": "merchant_acme_01",
  "payload": {
    "order_id": "ord_acme_8801",
    "amount": 25000
  },
  "idempotency_key": "tx_acme_sale_8801"
}

