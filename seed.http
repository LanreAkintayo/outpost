@baseUrl = http://127.0.0.1:8080
@apiKey = op_live_1ef49c22c63b7b4edfc9b973a8f81c63adf3bbd64504ebf5
@appId = 4963dec8-67a7-4b69-aff2-6f8bf4c48801

###############################################################################
# STEP 1: CREATE TENANT APPLICATION (ALREADY CREATED)
###############################################################################

### 1. Create Application (PayNova) - Skip if already created
# @name createPayNova
POST {{baseUrl}}/api/v1/applications
Content-Type: application/json

{
  "name": "PayNova"
}

### Auto-captured Credentials (uncomment if you create a new application)
# @apiKey = {{createPayNova.response.body.api_key}}
# @appId = {{createPayNova.response.body.id}}


###############################################################################
# STEP 2: CREATE EVENT TYPES
###############################################################################

### 2.1 Event Type: payment.succeeded
# @name evPaymentSucceeded
POST {{baseUrl}}/api/v1/event-types
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "name": "payment.succeeded",
  "description": "Triggered when a charge is successfully captured"
}

### 2.2 Event Type: payment.failed
# @name evPaymentFailed
POST {{baseUrl}}/api/v1/event-types
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "name": "payment.failed",
  "description": "Triggered when a customer card payment is declined"
}

### 2.3 Event Type: refund.created
# @name evRefundCreated
POST {{baseUrl}}/api/v1/event-types
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "name": "refund.created",
  "description": "Triggered when a refund is issued to a customer"
}

### 2.4 Event Type: customer.created
# @name evCustomerCreated
POST {{baseUrl}}/api/v1/event-types
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "name": "customer.created",
  "description": "Triggered when a new end-user account is registered"
}

